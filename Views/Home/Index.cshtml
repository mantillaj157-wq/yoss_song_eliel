@section Scripts {
    <script>
        // Script Web Speech API para la barra de búsqueda del Inicio
        const homeVoiceBtn = document.getElementById('homeVoiceBtn');
        const homeSearchInput = document.getElementById('homeSearchInput');
        const homeVoiceStatus = document.getElementById('homeVoiceStatus');

        if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            const recognition = new SpeechRecognition();
            recognition.lang = 'es-ES';
            recognition.continuous = false;
            recognition.interimResults = false;

            homeVoiceBtn.addEventListener('click', () => {
                try {
                    recognition.start();
                    homeVoiceStatus.textContent = "🎙️ Escuchando búsqueda...";
                    homeVoiceBtn.style.backgroundColor = "#e54b00";
                } catch (e) {
                    console.error(e);
                }
            });

            recognition.onresult = (event) => {
                const spokenText = event.results[0][0].transcript;
                homeSearchInput.value = spokenText;
                homeVoiceStatus.textContent = `✅ Búsqueda por voz: "${spokenText}"`;
                homeVoiceBtn.style.backgroundColor = "#ff5500";

                // Opcional: Redirigir al gestor pasando el filtro de búsqueda si se desea
                setTimeout(() => {
                    window.location.href = '@Url.Action("Index", "Songs")';
                }, 1500);
            };

            recognition.onerror = (event) => {
                homeVoiceStatus.textContent = "❌ Error en el reconocimiento de voz.";
                homeVoiceBtn.style.backgroundColor = "#ff5500";
            };

            recognition.onend = () => {
                homeVoiceBtn.style.backgroundColor = "#ff5500";
            };
        } else {
            homeVoiceBtn.style.display = 'none';
            homeVoiceStatus.textContent = "⚠️ Tu navegador no soporta Web Speech API.";
        }
    </script>
}